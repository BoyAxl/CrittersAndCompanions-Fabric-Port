{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Critters and Companions is a vanilla-style creature mod which fills the overworld with new animals.",
  "authors": [
    "${mod_author}"
  ],
  "icon": "logo.png",
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.eterdelta.crittersandcompanions.CrittersAndCompanionsFabric"
    ],
    "client": [
      "com.github.eterdelta.crittersandcompanions.CrittersAndCompanionsFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "forgeconfigapiport": ">=${forge_config_port_version}",
    "geckolib": ">=${geckolib_version}"
  }
}
